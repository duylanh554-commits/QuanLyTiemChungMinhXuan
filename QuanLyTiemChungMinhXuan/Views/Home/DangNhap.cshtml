@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card border-0 shadow">
            <div class="card-header bg-primary text-white text-center py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-shield-lock me-2"></i>ĐĂNG NHẬP HỆ THỐNG Y TẾ</h5>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2">@ViewBag.Error</div>
                }
                <form asp-action="DangNhap" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tài khoản</label>
                        <input type="text" name="tenDangNhap" class="form-control" value="admin" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" name="matKhau" class="form-control" value="123456" required />
                    </div>
                    <div class="alert alert-info py-2 small">
                        <strong>Tài khoản mẫu Admin:</strong> <code>admin</code> / Mật khẩu: <code>123456</code>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2">ĐĂNG NHẬP</button>
                </form>
            </div>
        </div>
    </div>
</div>